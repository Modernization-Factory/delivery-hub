# Real sign-in mappings must never be committed. Negations come last: in .gitignore the
# last matching rule wins, so an un-anchored pattern below a negation would re-ignore it.
identities.*.json
!api/scripts/identities.local.json
!api/scripts/identities.example.json

.env
.env.*
!.env.example
.DS_Store

# Local-only data and scripts: real employee emails, working copies of the source
# workbooks, and one-off importers that aren't part of the shared seed pipeline.
raw-seed-files/employee_emails.xlsx
raw-seed-files/Resource Allocation - Mar'26 ++.xlsx
api/scripts/import-leaves.js

# Dependencies are installed, not committed: both package-lock.json files are
# tracked, so `npm ci` reproduces them exactly.
node_modules/

# Build output and caches
web/dist/
web/node_modules/.cache/
