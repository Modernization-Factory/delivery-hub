MONGODB_URI=mongodb://localhost:27017
DB_NAME=deliveryhub
AUTH_MODE=proxy-headers            # or: oidc
TRUSTED_EMAIL_HEADER=x-forwarded-email
# OKTA_ISSUER=https://<org>.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# SESSION_SECRET=<32+ random bytes>
APP_URL=http://localhost:8080
PORT=8080
SESSION_TTL_HOURS=10
